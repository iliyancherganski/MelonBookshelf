@using MelonBookshelf.Models.Requests
@model RequestEditViewModel
<form id="AddRequestForm" method="post">

    <div>
        <div style="padding-bottom: 20px">
            <label>Priority</label>
            <select asp-for="@Model.Priority" class="form-control">
                @foreach (var item in Model.Priorities)
                {
                    <option name="Priority" value="@item.Name">@item.Name</option>
                }
            </select>
        </div>
    </div>

    <div>
        <div class="text-lg-start" style="padding-bottom: 20px;">
            <label style="padding-left: 10px;" asp-for="@Model.Title"></label>
            <input class="form-control" aria-required="true" asp-for="@Model.Title" />
            <span asp-validation-for="@Model.Title" class="text-danger"></span>
        </div>

        <div class="text-lg-start" style="padding-bottom: 20px;">
            <label style="padding-left: 10px;" asp-for="@Model.Author"></label>
            <input class="form-control" aria-required="true" asp-for="@Model.Author" />
            <span asp-validation-for="@Model.Author" class="text-danger"></span>
        </div>

        <div class="text-lg-start" style="padding-bottom: 20px;">
            <label style="padding-left: 10px;" asp-for="@Model.Justification"></label>
            <input type="text" class="multiline-input" aria-required="true" asp-for="@Model.Justification" />
            <span asp-validation-for="@Model.Justification" class="text-danger"></span>
        </div>
    </div>

    <div style="padding-bottom: 20px">
        <label>Categories</label>
        @foreach (var item in Model.Categories)
        {
            <input type="checkbox" value="@item.Id" name="CategoryIds" />
            <label>@item.Name</label>
        }
    </div>
    <button class="btn btn-danger" stype="width:130px" asp-action="Add" asp-controller="Request">Add</button>
</form>